{
  "$schema": "https://mintlify.com/docs.json",
  "name": "ECORPA",
  "theme": "maple",
  "colors": {
    "primary": "#09aff4",
    "light": "#3bc4f8",
    "dark": "#0d1857"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Sitio web",
          "icon": "globe",
          "href": "https://ecorpa.com"
        },
        {
          "anchor": "App",
          "icon": "layout-dashboard",
          "href": "https://app.ecorpa.com"
        }
      ]
    },
    "groups": [
      {
        "group": "Guía",
        "icon": "book-open",
        "pages": [
          "index",
          "introduction",
          "authentication",
          "quickstart"
        ]
      },
      {
        "group": "Servicios",
        "icon": "layers",
        "pages": [
          "consultas-seguridad-social",
          "consultas-seguridad-social/adres",
          "consulta-antecedentes",
          "consulta-antecedentes/persona-natural",
          "formularios-afiliacion",
          "formularios-afiliacion/eps",
          "formularios-afiliacion/ccf",
          "formularios-afiliacion/eps-ccf"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Ir a la App",
      "href": "https://app.ecorpa.com"
    },
    "links": []
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ecorpa"
    }
  },
  "description": "Documentación de las APIs de ECORPA para integradores.",
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png",
    "href": "https://ecorpa.com"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Jost",
    "heading": {
      "family": "Jost",
      "weight": 600
    },
    "body": {
      "family": "Jost",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  }
}
