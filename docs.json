      "family": "Jost",
      "weight": 600
    },
    "body": {
      "family": "Jost",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "api": {
    "mdx": {
      "server": "https://apis.ecorpa.com",
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "examples": {
      "languages": ["bash", "javascript", "python"]
    }
  }
